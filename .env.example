# Application
APP_NAME=ContentPilot
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Samara

# PostgreSQL
POSTGRES_HOST=content-pilot-db
POSTGRES_PORT=5432
POSTGRES_DB=content_pilot
POSTGRES_USER=content_pilot
POSTGRES_PASSWORD=change_me
# DATABASE_URL=

# Redis and Celery scheduling
REDIS_HOST=content-pilot-redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=
CELERY_DISPATCH_INTERVAL_SECONDS=60
CELERY_WORKER_CONCURRENCY=1
PUBLICATION_MAX_RETRIES=3
PUBLICATION_RETRY_BASE_SECONDS=30
PUBLISHING_DRY_RUN=false

# AI runtime (required only for generation endpoints/manual M2 smoke)
AI_TEXT_MODEL=openai/gpt-4.1-mini
AI_IMAGE_MODEL=openai/gpt-image-1-mini
AI_TIMEOUT_SECONDS=60
MEDIA_ROOT=/app/data/media

# ProxyAPI
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_TEXT_MODEL=
PROXYAPI_IMAGE_MODEL=openai/gpt-image-1-mini

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VK
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=
VK_USER_ACCESS_TOKEN=
VK_CLIENT_ID=
VK_REDIRECT_URI=
VK_OAUTH_SCOPE=photos wall

# LinkedIn — currently blocked, future use only
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
