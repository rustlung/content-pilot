# Docker image published by GitHub Actions; use a SHA tag for a deterministic deploy.
CONTENT_PILOT_IMAGE=ghcr.io/your-github-owner/content-pilot:sha-replace-with-commit-sha
CONTENT_PILOT_HOST_PORT=8000

# Application
APP_NAME=ContentPilot
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Samara

# PostgreSQL
POSTGRES_HOST=content-pilot-db
POSTGRES_PORT=5432
POSTGRES_DB=content_pilot
POSTGRES_USER=content_pilot
POSTGRES_PASSWORD=replace_with_a_strong_password

# Redis and Celery
REDIS_HOST=content-pilot-redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=
CELERY_DISPATCH_INTERVAL_SECONDS=60
CELERY_WORKER_CONCURRENCY=1
PUBLICATION_MAX_RETRIES=3
PUBLICATION_RETRY_BASE_SECONDS=30
PUBLISHING_DRY_RUN=false
SOCIAL_HTTP_TIMEOUT_SECONDS=30

# AI generation
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
AI_TEXT_MODEL=openai/gpt-4.1-mini
AI_IMAGE_MODEL=openai/gpt-image-1-mini
AI_TIMEOUT_SECONDS=60
MEDIA_ROOT=/app/data/media

# Telegram (provided only to content-pilot-worker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VK community (provided only to content-pilot-worker)
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
